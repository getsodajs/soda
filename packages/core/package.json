{
  "name": "@getsoda/core",
  "version": "0.2.2",
  "description": "Class-based web framework for Bun: modules, dependency injection and decorators like Nest, on Bun's native router",
  "keywords": [
    "bun",
    "framework",
    "http",
    "server",
    "router",
    "dependency-injection",
    "decorators",
    "nest"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsodajs/soda.git"
  },
  "homepage": "https://github.com/getsodajs/soda#readme",
  "bugs": {
    "url": "https://github.com/getsodajs/soda/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt/index.d.ts",
      "default": "./dist/jwt/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/testing.ts"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "cd ../.. && bun run lint && bun run typecheck && bun run test && cd packages/core && bun run build"
  }
}
