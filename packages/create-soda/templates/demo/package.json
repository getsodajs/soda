{
  "name": "soda-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "debug": "bun --inspect --hot src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outdir dist --minify --sourcemap=linked",
    "start:prod": "bun dist/main.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "typecheck": "bun check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@getsoda/core": "workspace",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  }
}
