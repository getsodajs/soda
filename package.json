{
  "name": "@soda/core",
  "version": "0.1.0",
  "description": "Class-based web framework for Bun: modules, dependency injection and decorators like Nest, on Bun's native router",
  "keywords": [
    "bun",
    "framework",
    "http",
    "server",
    "router",
    "dependency-injection",
    "decorators",
    "nest"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/testing.ts"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "bun check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "bun test",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "latest",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  }
}
